 # setverpart name NAME
 verpart() {
-	q=`grep '#define' patchlevel.h | grep "$2" | head -1 | sed -r -e "s/#define $2\s+//" -e "s/\s.*//"`
+	q=`grep '#define' patchlevel.h | grep "$2" | head -1 | sed -r -e "s/#define $2[[:space:]]+//" -e "s/[[:space:]].*//"`
